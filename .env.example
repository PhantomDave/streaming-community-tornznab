SC_BASE_URL=https://streamingcommunity.example
# Optional: enables the AnimeUnity provider as a second content source
# (leave empty to run with StreamingCommunity only). Use the www-prefixed
# host (e.g. https://www.animeunity.so) — the bare domain 302-redirects
# there, which downgrades our POST /livesearch requests to GET.
ANIMEUNITY_BASE_URL=
PUBLIC_URL=http://localhost:9118
HOST=0.0.0.0
PORT=9118
TORZNAB_API_KEY=change-me
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin
DOWNLOAD_PATH=/data/downloads
QUALITIES=1080,720,480
PREFERRED_AUDIO=ita,eng
RELEASE_GROUP=SC
TMDB_API_KEY=
MAX_CONCURRENT_DOWNLOADS=2
PLAYLIST_CACHE_TTL=21600
TITLE_CACHE_TTL=3600
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
DB_PATH=/data/db/sctorznab.db
LOG_LEVEL=INFO
MAX_RETRIES=2
DOWNLOAD_STALL_TIMEOUT=180
DOWNLOAD_PROGRESS_POLL_INTERVAL=10
DOWNLOAD_RETRY_BACKOFF_BASE=30
DOWNLOAD_RETRY_BACKOFF_MAX=600
DOWNLOAD_WATCHDOG_INTERVAL=60
DOWNLOAD_CONCURRENT_FRAGMENTS=4
VERBOSE_DOWNLOADS=true
REQUEST_TIMEOUT=20
USER_AGENT=Mozilla/5.0
SC_LOCALE=it
# Optional: URL of a FlareResolverr instance used to solve Cloudflare challenges
# that block the vixcloud.co playlist/stream requests (leave empty to disable).
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000
